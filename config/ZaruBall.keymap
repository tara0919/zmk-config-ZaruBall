//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <mouse-gesture.dtsi>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define SLOW     4
#define ADJUST   5

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          INTERNATIONAL_3   // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(INTERNATIONAL_3) // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(INTERNATIONAL_1) // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_BSLASH       INTERNATIONAL_1   // \ (ろ)

// スクロール量の設定（デフォルト10を100に上書き）

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/ {
    inertial_scroll: inertial_scroll {
        compatible = "zmk,input-processor-inertial-scroll";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_Y>;
        output-code = <INPUT_REL_WHEEL>;
        interval-ms = <12>;
        gain-percent = <2>;
        start-threshold = <1>;
        burst-threshold = <14>;
        burst-peak-threshold = <6>;
        burst-peak-percent = <0>;
        burst-timeout-ms = <25>;
        burst-window-ms = <25>;
        release-ms = <35>;
        decay-percent = <98>;
        stop-threshold = <12>;
        max-step = <1>;
        required-layer = <LOWER>;
    };
};

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_mouse_gesture
                         &mouse_temp_layer MOUSE 500
    >;

    // レイヤー2 (Lower): 縦スクロールのみ（X軸をゼロにしてH-scrollを無効化）

    scroller {
        layers = <LOWER>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_x_scaler 0 1
                            &inertial_scroll
                            &zip_xy_scaler 1 70
                            &zip_xy_to_scroll_mapper
        >;
    };

    // レイヤー3 (Raise): 横スクロールのみ（Y軸をゼロにしてV-scrollを無効化）

    scroller_h {
        layers = <RAISE>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_y_scaler 0 1
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };

    // レイヤー4 (Slow): カーソル速度を半分に

    slow_cursor {
        layers = <SLOW>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 2
        >;
    };
};

// マウスジェスチャーの設定

&zip_mouse_gesture {
    stroke-size = <100>;
    enable-eager-mode;

    // 左スワイプ → Win+1
    win1 {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(N1)>;
    };

    // 上スワイプ → Win+2
    win2 {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(N2)>;
    };

    // 下スワイプ → Win+3
    win3 {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(N3)>;
    };

    // 右スワイプ → Win+4
    win4 {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(N4)>;
    };
};

/ {
    mouse_temp_layer: mouse_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <300>;
        excluded-positions = <45 46 47>;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
};

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <175>; // 素早いダブルタップ・連続入力を可能にしてレスポンスを改善
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        battery_text: battery_text {
            compatible = "zmk,behavior-battery-text";
            #binding-cells = <0>;
            display-name = "Battery Text";
        };

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>; // スクロールのタップ時間
        };


        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        // US→JP変換用 mod-morph behaviors
        // Shift押下時に正しいUS記号を出力するための変換

        jm_n2: jm_n2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F2 N2>, <&kp JP_AT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n6: jm_n6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F6 N6>, <&kp JP_CARET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n7: jm_n7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F7 N7>, <&kp JP_AMPERSAND>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n8: jm_n8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F8 N8>, <&kp JP_ASTERISK>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n9: jm_n9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F9 N9>, <&kp JP_LPAREN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n0: jm_n0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F10 N0>, <&kp JP_RPAREN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_minus: jm_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp INTERNATIONAL_1>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_equal: jm_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_EQUAL>, <&kp JP_PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_semi: jm_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp JP_COLON>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_sqt: jm_sqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_QUOTE>, <&kp JP_DQUOTE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_grave: jm_grave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_BACKQUOTE>, <&kp JP_TILDE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ' (Shift: ~) 用 mod-morph

        jm_sqt_tilde: jm_sqt_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_QUOTE>, <&kp JP_TILDE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // [ (Shift: {) 用 mod-morph

        jm_lbkt: jm_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_LBRACKET>, <&kp JP_LBRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ] (Shift: }) 用 mod-morph

        jm_rbkt: jm_rbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_RBRACKET>, <&kp JP_RBRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // \ (Shift: |) 用 mod-morph

        jm_bslash: jm_bslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INTERNATIONAL_1>, <&kp INTERNATIONAL_3>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 数字キー長押しでFキーを出力するための hold-tap behavior

        numht: numht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        lt_mkp: layer_tap_mouse_button {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&mkp>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        // Shift+右クリック用マクロ

        shift_rclick: shift_rclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&mkp MB2>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        // 文字列入力マクロ: tara_dart2

        type_tara_dart2: type_tara_dart2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp T &kp A &kp R &kp A>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp INTERNATIONAL_1>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp D &kp A &kp R &kp T &kp N2>;
        };

        // 文字列入力マクロ: Tara_baseba11

        type_tara_base: type_tara_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp T>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp A &kp R &kp A>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp INTERNATIONAL_1>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp B &kp A &kp S &kp E &kp B &kp A &kp N1 &kp N1>;
        };

        // 括弧ペア入力マクロ: () + カーソルを間に

        type_parens: type_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp JP_KANA &kp JP_LPAREN &kp JP_RPAREN &kp ENTER &kp LEFT>;
        };

        // 括弧ペア入力マクロ: [] + カーソルを間に

        type_brackets: type_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp JP_KANA &kp JP_LBRACKET &kp JP_RBRACKET &kp ENTER &kp LEFT>;
        };

        type_00: type_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp JP_EISU &kp KP_NUMBER_0 &kp KP_NUMBER_0>;
        };

        num_eisu: num_eisu {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp JP_EISU>, <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };

        // 左クリック×2（ダブル左クリック）

        double_lclick: double_lclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap>, <&mkp MB1 &mkp MB1>;
        };

        // Ctrl+左クリック

        ctrl_lclick: ctrl_lclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&mkp MB1>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        macro_f2_kana: macro_f2_kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp F2 &kp JP_KANA>;
        };

        type_ab3233921: type_ab3233921 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp JP_EISU &kp A &kp B &kp N3 &kp N2 &kp N3 &kp N3 &kp N9 &kp N2 &kp N1>;
        };
    };
};

// Shift+右クリック用 tap-dance

/ {
    behaviors {
        td_rclick: td_rclick {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp MB2>, <&shift_rclick>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        center_click {
            bindings = <&mkp MB3>;
            key-positions = <28 29>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <46 47>;
        };

        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <63 64>;
        };

        mb5 {
            bindings = <&mkp MB5>;
            key-positions = <64 65>;
        };

        task_viewer {
            bindings = <&kp LG(TAB)>;
            key-positions = <36 72>;
        };

        combo_lparen {
            timeout-ms = <50>;
            key-positions = <19 20>; // D + F
            bindings = <&kp JP_LPAREN>;
        };

        combo_rparen {
            timeout-ms = <50>;
            key-positions = <27 28>; // U + I
            bindings = <&kp JP_RPAREN>;
        };

        close {
            bindings = <&kp LA(F4)>;
            key-positions = <35 36 72>;
        };

        plane_paste {
            bindings = <&mt LG(V) LC(LS(V))>;
            key-positions = <54 72>;
        };

        win+d {
            bindings = <&kp LG(D)>;
            key-positions = <35 72>;
        };

        f2 {
            bindings = <&macro_f2_kana>;
            key-positions = <35 36>;
        };

        combo_eisu_dk {
            timeout-ms = <50>;
            key-positions = <35 46>; // D + K
            bindings = <&kp JP_EISU>;
        };

        new_folder {
            bindings = <&kp LS(LC(N))>;
            key-positions = <34 35>; // S + D
        };

        combo_tara_dart2 {
            timeout-ms = <50>;
            key-positions = <30 33>; // P + A
            bindings = <&type_tara_dart2>;
        };

        combo_tara_base {
            timeout-ms = <50>;
            key-positions = <30 33 34>; // P + A + S
            bindings = <&type_tara_base>;
        };

        combo_parens {
            timeout-ms = <50>;
            key-positions = <19 20 28 27>; // E + R + U + I
            bindings = <&type_parens>;
        };

        double_left_click {
            timeout-ms = <50>;
            key-positions = <45 46>; // J + K
            bindings = <&double_lclick>;
        };

        shift_right_click {
            timeout-ms = <50>;
            key-positions = <45 46 47>; // J + K + L
            bindings = <&shift_rclick>;
        };

        combo_brackets_jp {
            timeout-ms = <50>;
            key-positions = <38 43>; // 「 + 」
            bindings = <&type_brackets>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <36 45>; // F + J
            bindings = <&kp JP_KANA>;
        };

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <35 45 36>; // D + J
            bindings = <&kp JP_EISU>;
        };

        close_2 {
            bindings = <&kp RA(F4)>;
            key-positions = <45 46 75>;
        };

        win+d_2 {
            bindings = <&kp RG(D)>;
            key-positions = <46 75>;
        };

        task_view_2 {
            bindings = <&kp RG(TAB)>;
            key-positions = <45 75>;
        };

        alt+tab {
            bindings = <&kp LA(TAB)>;
            key-positions = <36 73>;
        };

        combo_gesture {
            timeout-ms = <50>;
            key-positions = <45 47>; // J + L
            bindings = <&mouse_gesture>;
        };

        combo_ab3233921 {
            timeout-ms = <50>;
            key-positions = <33 55>; // A + B
            bindings = <&type_ab3233921>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESCAPE      &numht F1 N1  &jm_n2       &numht F3 N3   &numht F4 N4     &numht F5 N5                     &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                                 &jm_n6           &jm_n7       &jm_n8       &jm_n9       &jm_n0       &jm_sqt_tilde
&kp LEFT_ALT    &kp Q         &mt LC(W) W  &kp E          &mt LC(R) R      &mt LC(T) T                      &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                               &mt LC(Y) Y      &mt LC(U) U  &mt LC(I) I  &kp O        &mt LC(P) P  &jm_equal
&kp LEFT_SHIFT  &mt LC(A) A   &mt LC(S) S  &mt LC(D) D    &mt LEFT_ALT F   &kp G            &jm_lbkt        &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &jm_rbkt                   &mt LC(H) H      &kp J        &lt LOWER K  &lt RAISE L  &lt SLOW MINUS  &kp SLASH
&kp LCTRL       &mt LC(Z) Z   &mt LC(X) X  &mt LC(C) C    &mt LC(V) V      &mt LC(B) B      &kp INSERT      &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp LG(TAB)                &mt LC(N) N      &kp M        &kp COMMA    &kp DOT      &jm_semi     &jm_sqt
&kp LEFT_WIN    &kp C_MUTE                 &kp LS(LG(S))  &lt RAISE GRAVE  &lt LOWER ENTER  &mt LEFT_SHIFT TAB                                                       &kp BACKSPACE              &lt RAISE SPACE                                                      &jm_bslash
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB1  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                    &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
