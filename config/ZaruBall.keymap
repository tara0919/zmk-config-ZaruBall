//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 500
    >;

    // レイヤー2 (Lower): 縦スクロールのみ（X軸をゼロにしてH-scrollを無効化）

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_x_scaler 0 1
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };

    // レイヤー3 (Raise): 横スクロールのみ（Y軸をゼロにしてV-scrollを無効化）

    scroller_h {
        layers = <RAISE>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_y_scaler 0 1
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };

    // レイヤー4 (Slow): カーソル速度を半分に

    slow_cursor {
        layers = <4>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 2
                            &zip_temp_layer MOUSE 500
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};

&mt { flavor = "tap-preferred"; };

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo 3>, <&mo 1>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo 3>, <&mo 1>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        // US→JP変換用 mod-morph behaviors
        // Shift押下時に正しいUS記号を出力するための変換

        jm_n2: jm_n2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F2 N2>, <&kp JP_AT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n6: jm_n6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F6 N6>, <&kp JP_CARET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n7: jm_n7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F7 N7>, <&kp JP_AMPERSAND>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n8: jm_n8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F8 N8>, <&kp JP_ASTERISK>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n9: jm_n9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F9 N9>, <&kp JP_LPAREN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_n0: jm_n0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F10 N0>, <&kp JP_RPAREN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_minus: jm_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp JP_UNDERSCORE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_equal: jm_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_EQUAL>, <&kp JP_PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_semi: jm_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp JP_COLON>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_sqt: jm_sqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_QUOTE>, <&kp JP_DQUOTE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jm_grave: jm_grave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_BACKQUOTE>, <&kp JP_TILDE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ' (Shift: ~) 用 mod-morph

        jm_sqt_tilde: jm_sqt_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_QUOTE>, <&kp JP_TILDE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // [ (Shift: {) 用 mod-morph

        jm_lbkt: jm_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_LBRACKET>, <&kp JP_LBRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ] (Shift: }) 用 mod-morph

        jm_rbkt: jm_rbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_RBRACKET>, <&kp JP_RBRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // \ (Shift: |) 用 mod-morph

        jm_bslash: jm_bslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp 0x87>, <&kp JP_PIPE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 数字キー長押しでFキーを出力するための hold-tap behavior

        numht: numht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // レイヤー2のAキー用 (長押し: dup_tab, タップ: LG(NUMBER_1))
        
        a_ht: a_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&dup_tab>, <&kp>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 1>;

            label = "MKP_EXIT_AML";
        };

        // エクスプローラーのタブ複製マクロ

        dup_tab: duplicate_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings
                = <&macro_tap &kp LA(D)>
                , <&macro_tap &kp LC(C)>
                , <&macro_tap &kp LC(T)>
                , <&macro_wait_time 200>
                , <&macro_tap &kp LA(D)>
                , <&macro_tap &kp LC(V)>
                , <&macro_tap &kp RET>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        center_click {
            bindings = <&mkp MB3>;
            key-positions = <45 46 47>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <46 47>;
        };

        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <63 64>;
        };

        mb5 {
            bindings = <&mkp MB5>;
            key-positions = <64 65>;
        };

        task_viewer {
            bindings = <&kp LG(TAB)>;
            key-positions = <36 73>;
        };

        combo_lparen {
            timeout-ms = <50>;
            key-positions = <35 36>; // D + F
            bindings = <&kp JP_LPAREN>;
        };

        combo_rparen {
            timeout-ms = <50>;
            key-positions = <45 46>; // J + K
            bindings = <&kp JP_RPAREN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC         &numht F1 N1  &jm_n2       &numht F3 N3    &numht F4 N4    &numht F5 N5                &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                                 &jm_n6       &jm_n7       &jm_n8       &jm_n9   &jm_n0       &jm_sqt_tilde
&kp LEFT_ALT    &kp Q         &mt LC(W) W  &kp E           &mt LC(R) R     &mt LC(T) T                 &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                               &kp Y        &mt LC(U) U  &mt LC(I) I  &kp O    &mt LC(P) P  &jm_equal
&kp LEFT_SHIFT  &mt LC(A) A   &mt LC(S) S  &mt LG(D) D     &mt LEFT_ALT F  &kp G         &jm_lbkt      &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &jm_rbkt                   &kp H        &kp J        &lt 2 K      &lt 3 L  &jm_minus    &kp SLASH
&kp LCTRL       &mt LC(Z) Z   &mt LC(X) X  &mt LC(C) C     &mt LC(V) V     &mt LC(B) B   &kp INSERT    &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &mt LA(LC(DELETE)) DELETE  &kp N        &kp M        &kp COMMA    &kp DOT  &jm_semi     &jm_bslash
&kp LS(LG(S))   &kp C_MUTE                 &lt 4 LEFT_WIN  &lt 3 GRAVE     &lt 2 ENTER   &lt 4 TAB                                                             &kp BACKSPACE              &lt 3 SPACE                                                  &lt 5 BACKSLASH
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB1  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                    &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &trans            &trans            &trans            &trans            &trans                &trans  &trans  &trans  &trans                       &trans        &trans    &trans    &trans     &trans         &trans
&trans  &trans            &kp LS(LC(TAB))   &kp LC(W)         &kp LC(TAB)       &trans                &trans  &trans  &trans  &trans                       &trans        &trans    &kp UP    &trans     &trans         &trans
&trans  &a_ht 0 LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(N5)  &trans    &trans  &trans  &trans  &trans    &trans             &kp LS(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(RIGHT)  &trans
&trans  &trans            &trans            &trans            &trans            &trans      &trans    &trans  &trans  &trans  &trans    &trans             &trans        &trans    &trans    &trans     &trans         &trans
&trans  &trans                              &trans            &trans            &trans      &trans                                      &mt LA(F4) DELETE  &trans                                                      &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans  &trans                        &trans                        &trans                        &trans                        &kp KP_SLASH               &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans                        &mt LC(NUMBER_7) KP_NUMBER_7  &mt LC(NUMBER_8) KP_NUMBER_8  &mt LC(NUMBER_9) KP_NUMBER_9  &kp KP_MULTIPLY            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans                        &mt LC(NUMBER_4) KP_NUMBER_4  &mt LC(NUMBER_5) KP_NUMBER_5  &mt LC(NUMBER_6) KP_NUMBER_6  &kp KP_MINUS     &trans    &trans  &trans  &trans  &trans    &trans  &trans  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &mt LC(NUMBER_0) KP_NUMBER_0  &mt LC(NUMBER_1) KP_NUMBER_1  &mt LC(NUMBER_2) KP_NUMBER_2  &mt LC(NUMBER_3) KP_NUMBER_3  &kp KP_PLUS      &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans                                                      &mt LC(NUMBER_0) KP_NUMBER_0  &kp PERIOD                    &kp ENTER        &trans                                      &trans  &trans                                   &trans
            >;
        };

        slow_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB1  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                    &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans    &trans                                      &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
