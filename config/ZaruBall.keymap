// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <mouse-gesture.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ジェスチャー用ホールドタップ設定の修正 (モジュール側の不足分) */

&mouse_gesture_mkp {
    tapping-term-ms = <200>;
    quick-tap-ms = <100>;
};

&mouse_gesture_kp {
    tapping-term-ms = <200>;
    quick-tap-ms = <100>;
};

#define BASE     0
#define LOWER    1
#define RAISE    2
#define ADJUST   3
#define MOUSE    4
#define SCROLL   5
#define H_SCROLL 6
#define SNIPER   7

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

// ジェスチャー設定

&zip_mouse_gesture {
    stroke-size = <150>;
    enable-eager-mode;

    // 上: Win+Tab (タスクビュー)

    task_view {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(TAB)>;
    };

    // 下: Win+3

    win3 {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(N3)>;
    };

    // 左: Win+2

    win2 {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(N2)>;
    };

    // 右: Win+4

    win4 {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(N4)>;
    };
};

&trackball_listener {
    input-processors = <
                         &zip_mouse_gesture
                         &zip_temp_layer MOUSE 500
    >;

    // 横スクロールを優先的に判定 (Lキー押下時)

    h_scroller {
        layers = <H_SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)
                            &zip_y_scaler 0 1
                            &zip_xy_scaler 1 40
                            &zip_xy_to_scroll_mapper
        >;
    };

    // デフォルトの縦スクロール (Kキー持続時)

    v_scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)
                            &zip_x_scaler 0 1
                            &zip_xy_scaler 1 40
                            &zip_xy_to_scroll_mapper
        >;
    };

    sniper {
        layers = <SNIPER>;
        input-processors = <
                            &zip_xy_scaler 1 2
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_lparen {
            timeout-ms = <50>;
            key-positions = <35 36>; // D + F
            bindings = <&kp JP_LPAREN>;
        };

        combo_rparen {
            timeout-ms = <50>;
            key-positions = <45 46>; // J + K
            bindings = <&kp JP_RPAREN>;
        };

        combo_ins {
            timeout-ms = <50>;
            key-positions = <38 43>; // [ + ]
            bindings = <&kp INS>;
        };
    };
};

/ {
    behaviors {
        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        td_lang: tap_dance_lang {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LANG1>, <&kp LANG2>;
        };

        td_n: tap_dance_n {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(E)>, <&kp LC(N)>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        lt_to: behavior_hold_tap_to_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&to>;
        };

        ht_win_tab: ht_win_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&macro_win_tab>, <&kp>;
        };

        ht_win_d: ht_win_d {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&macro_win_d>, <&kp>;
        };

        ht_mouse_win_d: ht_mouse_win_d {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&macro_win_d>, <&to_layer_0>;
        };

        ht_mouse_l0_alt: ht_mouse_l0_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&l0_alt>, <&to_layer_0>;
        };

        ht_mouse_win_tab: ht_mouse_win_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&macro_win_tab>, <&to_layer_0>;
        };

        ht_l0_alt: ht_l0_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&l0_alt>, <&kp>;
        };

        ht_l0_ctrl_a: ht_l0_ctrl_a {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&l0_ctrl_a>, <&kp>;
        };

        ht_l0_ctrl_x: ht_l0_ctrl_x {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&l0_ctrl_x>, <&kp>;
        };

        ht_l0_ctrl_c: ht_l0_ctrl_c {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&l0_ctrl_c>, <&kp>;
        };

        ht_l0_ctrl_v: ht_l0_ctrl_v {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&l0_ctrl_v>, <&kp>;
        };

        ht_l0_ctrl_z: ht_l0_ctrl_z {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&l0_ctrl_z>, <&kp>;
        };

        ht_l0_ctrl_s: ht_l0_ctrl_s {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&l0_ctrl_s>, <&kp>;
        };

        ht_l0_ctrl_b: ht_l0_ctrl_b {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&l0_ctrl_b>, <&kp>;
        };

        // US Keycap Emulation for JIS OS

        mm_n2: mm_n2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt F2 N2>, <&kp JP_AT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n6: mm_n6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt F6 N6>, <&kp JP_CARET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n7: mm_n7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt F7 N7>, <&kp JP_AMPERSAND>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n8: mm_n8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt F8 N8>, <&kp JP_ASTERISK>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n9: mm_n9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt F9 N9>, <&kp JP_LPAREN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n0: mm_n0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt F10 N0>, <&kp JP_RPAREN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_semi: mm_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp JP_COLON>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_quote: mm_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_QUOTE>, <&kp JP_DQUOTE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_minus: mm_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp JP_UNDERSCORE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_equal: mm_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt F12 JP_EQUAL>, <&kp JP_PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_grave: mm_grave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt F11 JP_BACKQUOTE>, <&kp JP_TILDE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_lbracket: mm_lbracket {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_LBRACKET>, <&kp JP_LBRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_rbracket: mm_rbracket {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_RBRACKET>, <&kp JP_RBRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_bslash: mm_bslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_YEN>, <&kp JP_PIPE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ht_rclk_scroll: ht_rclk_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        ht_lang_hscroll: ht_lang_hscroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&td_lang>;
        };

        ht_grave_adjust: ht_grave_adjust {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&to>, <&mm_grave>;
        };

        ht_bslash_adjust: ht_bslash_adjust {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&to>, <&mm_bslash>;
        };
    };
};

&zip_temp_layer { require-prior-idle-ms = <150>; };

&mt { tapping-term-ms = <150>; };

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        macro_win_tab: macro_win_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LG(TAB)>;
        };

        macro_win_d: macro_win_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LG(D)>;
        };

        to_layer_0_win_d: to_layer_0_win_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog MOUSE &kp LG(D)>;
            label = "TO_L0_WIN_D";
        };

        l0_alt: l0_alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT>;

            label = "L0_ALT";
        };

        l0_ctrl_a: l0_ctrl_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(A)>;
            label = "L0_CTRL_A";
        };

        l0_ctrl_x: l0_ctrl_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(X)>;
            label = "L0_CTRL_X";
        };

        l0_ctrl_c: l0_ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(C)>;
            label = "L0_CTRL_C";
        };

        l0_ctrl_v: l0_ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(V)>;
            label = "L0_CTRL_V";
        };

        l0_ctrl_z: l0_ctrl_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(Z)>;
            label = "L0_CTRL_Z";
        };

        l0_ctrl_s: l0_ctrl_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(S)>;
            label = "L0_CTRL_S";
        };

        l0_ctrl_b: l0_ctrl_b {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(B)>;
            label = "L0_CTRL_B";
        };

        macro_dzero: macro_dzero {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N0 &kp KP_N0>;
            label = "MACRO_DZERO";
        };

        to_l0_grave: to_l0_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mm_grave>;
            label = "TO_L0_GRAVE";
        };

        to_l0_equal: to_l0_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mm_equal>;
            label = "TO_L0_EQUAL";
        };

        to_l0_lbracket: to_l0_lbracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mm_lbracket>;
            label = "TO_L0_LBRACKET";
        };

        to_l0_rbracket: to_l0_rbracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mm_rbracket>;
            label = "TO_L0_RBRACKET";
        };

        to_l0_dot: to_l0_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp DOT>;
            label = "TO_L0_DOT";
        };

        to_l0_del: to_l0_del {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mt LA(F4) DEL>;
            label = "TO_L0_DEL";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&mt CAPSLOCK ESC &mt F1 N1             &mm_n2                &mt F3 N3             &mt F4 N4                    &mt F5 N5                            &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                     &mm_n6     &mm_n7  &mm_n8     &mm_n9   &mm_n0     &mm_grave
&kp LEFT_ALT    &kp Q                 &kp W                 &kp E                 &kp R                        &kp T                                &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                   &kp Y      &kp U   &kp I      &kp O    &kp P      &mm_equal
&kp LEFT_SHIFT  &ht_l0_ctrl_a BASE A  &ht_l0_ctrl_s BASE S  &ht_win_d BASE D      &ht_l0_alt BASE F            &kp G        &mm_lbracket            &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &mm_rbracket   &kp H      &kp J   &kp K      &kp L    &mm_minus  &kp SLASH
&kp LCTRL       &ht_l0_ctrl_z BASE Z  &ht_l0_ctrl_x BASE X  &ht_l0_ctrl_c BASE C  &ht_l0_ctrl_v BASE V         &ht_l0_ctrl_b BASE B &lt_to RAISE LOWER      &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &mt LA(F4) DEL &kp N      &kp M   &kp COMMA  &kp DOT  &mm_semi   &mm_quote
&kp LEFT_GUI    &trans                                      &mo 7                 &ht_lang_hscroll H_SCROLL 0  &lt 5 ENTER  &ht_win_tab BASE TAB                                                            &kp BACKSPACE  &kp SPACE                                         &ht_bslash_adjust ADJUST 0
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans      &kp F1     &kp F2           &kp F3           &kp F4           &kp F5                           &trans  &trans  &trans  &trans                   &kp F6     &kp F7    &kp F8    &kp F9     &kp F10  &kp F11
&trans      &trans     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans                           &trans  &trans  &trans  &trans                   &trans     &trans    &kp UP    &trans     &trans   &kp F12
&kp LSHIFT  &kp KP_N0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS  &kp KP_SLASH       &trans  &trans  &trans  &trans    &trans         &trans     &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
&kp LCTRL   &trans     &kp KP_N1        &kp KP_N2        &kp KP_NUMBER_3  &kp KP_PLUS   &kp KP_MULTIPLY    &trans  &trans  &trans  &trans    &trans         &td_n      &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)  &trans
&trans      &trans                      &to 0            &kp DOT          &kp ENTER     &kp TAB                                              &kp BACKSPACE  &kp SPACE                                          &to 0
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans        &kp F1  &kp F2  &kp F3     &kp F4     &kp F5                             &trans  &trans  &trans  &trans               &kp F6    &kp F7    &kp F8    &kp F9     &kp F10  &none
&kp LEFT_ALT  &none   &none   &none      &none      &none                              &trans  &trans  &trans  &trans               &none     &none     &none     &none      &none    &none
&trans        &none   &none   &mkp RCLK  &mkp LCLK  &msc SCRL_UP    &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &kp PG_UP  &kp HOME  &none     &kp UP    &none      &none    &none
&trans        &none   &none   &mkp MB4   &mkp MB5   &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &kp PG_DN  &kp END   &kp LEFT  &kp DOWN  &kp RIGHT  &none    &none
&trans        &none           &to BASE   &trans     &trans          &trans                                               &trans     &kp DEL                                           &to 0
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &to BASE      &trans        &trans        &trans                                      &trans    &kp DEL                                     &to 0
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&to_layer_0 ESC       &to_layer_0 N1        &to_layer_0 N2        &to_layer_0 N3          &to_layer_0 N4           &to_layer_0 N5                                &trans  &trans  &trans  &trans                           &to_layer_0 N6     &to_layer_0 N7  &to_layer_0 N8               &to_layer_0 N9   &to_layer_0 N0         &to_l0_grave
&to_layer_0 LEFT_ALT  &to_layer_0 Q         &to_layer_0 W         &to_layer_0 E           &to_layer_0 R            &to_layer_0 T                                 &trans  &trans  &trans  &trans                           &to_layer_0 Y      &to_layer_0 U   &mkp MCLK                    &to_layer_0 O    &to_layer_0 P          &to_l0_equal
&kp LEFT_SHIFT        &ht_l0_ctrl_a BASE A  &to_layer_0 S         &ht_mouse_win_d BASE D  &ht_mouse_l0_alt BASE F  &to_layer_0 G   &to_l0_lbracket               &trans  &trans  &trans  &trans    &trans                 &to_layer_0 H      &mkp LCLK       &ht_rclk_scroll SCROLL RCLK  &mo 6            &to_layer_0 MINUS      &to_l0_rbracket
&kp LCTRL             &to_layer_0 Z         &ht_l0_ctrl_x BASE X  &ht_l0_ctrl_c BASE C    &ht_l0_ctrl_v BASE V     &to_layer_0 B   &trans                        &trans  &trans  &trans  &trans    &trans                 &to_layer_0 N      &mkp MB4        &mouse_gesture_mkp 0 MB5     &to_l0_dot       &to_layer_0 SEMICOLON  &to_l0_del
&to_layer_0 LEFT_GUI  &trans                                      &mo 7                   &mo 6                    &lt 5 ENTER     &ht_mouse_win_tab BASE TAB                                      &to_layer_0 BACKSPACE  &to_layer_0 SPACE                                                                                       &to 0
            >;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans          &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                           &trans  &trans  &trans  &trans                   &kp F6     &kp F7            &kp F8            &kp F9            &kp F10           &kp F11
&trans          &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans                           &trans  &trans  &trans  &trans                   &trans     &kp LC(LS(TAB))   &kp UP            &kp LC(TAB)       &trans            &kp F12
&kp LEFT_SHIFT  &kp KP_NUMBER_0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS  &kp KP_DIVIDE      &trans  &trans  &trans  &trans    &trans         &trans     &kp LEFT          &kp DOWN          &kp RIGHT         &trans            &trans
&kp LCTRL       &macro_dzero     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS   &kp KP_MULTIPLY    &trans  &trans  &trans  &trans    &trans         &td_n      &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(NUMBER_5)  &trans
&trans          &trans                            &to 0            &kp DOT          &kp ENTER     &kp TAB                                              &kp BACKSPACE  &kp SPACE                                                                          &to 0
            >;
        };

        h_scroll_layer {
            display-name = "HScroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &to 0   &trans  &trans  &trans                                      &trans  &trans                                  &to 0
            >;
        };

        sniper_layer {
            display-name = "Sniper";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&trans          &trans  &trans  &trans     &trans     &trans            &trans  &trans  &trans  &trans            &trans  &trans     &trans     &trans  &trans  &trans
&trans          &trans  &trans  &trans     &trans     &trans            &trans  &trans  &trans  &trans            &trans  &trans     &trans     &trans  &trans  &trans
&kp LEFT_SHIFT  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&kp LCTRL       &trans  &trans  &trans     &trans     &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans          &trans          &to 0      &trans     &trans  &trans                                      &trans  &trans                                        &to 0
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
